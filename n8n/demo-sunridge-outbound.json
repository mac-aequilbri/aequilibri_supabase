{
  "name": "DEMO sunridge · outbound queue → mac@aequilibri",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "c1000000-0000-4000-8000-000000000001",
      "name": "Every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-240, 160]
    },
    {
      "parameters": {},
      "id": "c1000000-0000-4000-8000-000000000006",
      "name": "Manual test trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-240, -20]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://aequilibri-next.onrender.com/api/platform/outbox",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.OUTBOX_FEED_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "Fetch pending outbox events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-20, 60]
    },
    {
      "parameters": {
        "fieldToSplitOut": "events",
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000003",
      "name": "Split out events",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [200, 60]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.orgSlug }}",
              "rightValue": "sunridge",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000007",
      "name": "Only sunridge events",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [400, 60]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "mac@aequilibri.com",
        "subject": "=[aequilibri · sunridge] {{ $json.event }}",
        "emailType": "text",
        "message": "={{ $json.summary || $json.event }}\n\n—\nEvent: {{ $json.event }}\nEntity: {{ $json.entityType }} #{{ $json.entityId }}\nRaised: {{ $json.createdAt }}\n\nOpen the app: https://aequilibri-next.onrender.com/app/sunridge\n\nSent by the aequilibri outbound queue via n8n.",
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000004",
      "name": "Gmail — send to mac@aequilibri",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [620, 60]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://aequilibri-next.onrender.com/api/platform/outbox",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.OUTBOX_FEED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('Only sunridge events').item.json.id, status: 'delivered' }) }}",
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000005",
      "name": "Mark delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 60]
    }
  ],
  "connections": {
    "Every 2 minutes": {
      "main": [[{ "node": "Fetch pending outbox events", "type": "main", "index": 0 }]]
    },
    "Manual test trigger": {
      "main": [[{ "node": "Fetch pending outbox events", "type": "main", "index": 0 }]]
    },
    "Fetch pending outbox events": {
      "main": [[{ "node": "Split out events", "type": "main", "index": 0 }]]
    },
    "Split out events": {
      "main": [[{ "node": "Only sunridge events", "type": "main", "index": 0 }]]
    },
    "Only sunridge events": {
      "main": [[{ "node": "Gmail — send to mac@aequilibri", "type": "main", "index": 0 }]]
    },
    "Gmail — send to mac@aequilibri": {
      "main": [[{ "node": "Mark delivered", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
