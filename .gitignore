# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# office temp/lock files
~$*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite dev database — contains seed data, not for version control
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal

# local document storage (DriveStorer LocalFs implementation)
/var/

# local analysis / reverse-engineering scratch output (not repo material)
/outputs/

# ops secrets (Supabase access token etc.) — never commit
.env.ops

# terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
