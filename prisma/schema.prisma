// Approval queue for deferred AI writes — split out of PlatExecutionLog so
// the execution log stays an append-only audit trail while proposals carry
// mutable workflow state (status, resolution, expiry).
model PlatPendingWrite {
  id               Int       @id @default(autoincrement())
  // Airtable record-id bridge (backend-switch Phase B): the rec… id of this
  // row's counterpart in the org's Airtable base. Null = never synced.
  airtableRecordId String? @map("airtable_record_id") @db.VarChar(20)
  orgId            Int       @map("org_id")
  jobId            Int?      @map("job_id")
  tableKey         String    @map("table_key") @db.VarChar(50)
  op               String    @db.VarChar(10)
  recordId         Int?      @map("record_id")
  payload          String    @default("{}")
  actorType        String    @default("ai") @map("actor_type") @db.VarChar(20)
  actorName        String    @default("") @map("actor_name") @db.VarChar(200)
  sourceMessageId  Int?      @map("source_message_id")
  status           String    @default("proposed") @db.VarChar(20)
  resolvedBy       String    @default("") @map("resolved_by") @db.VarChar(200)
  resolvedAt       DateTime? @map("resolved_at")
  execLogId        Int?      @map("exec_log_id")
  error            String    @default("")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")


  @@index([orgId, status])
  @@unique([orgId, airtableRecordId])

  @@map("plat_core_pendingwrite")
}

