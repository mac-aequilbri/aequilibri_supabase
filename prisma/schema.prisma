  sourceType       String    @default("manual") @map("source_type") @db.VarChar(30)
  sourceId         Int?      @map("source_id")
  // Spec 10/12 ISSUES classifier + links (mirrors Issue_Type/PHASES/RISKS).
  // Added for the PG-native cascade engine (migration-plan Phase 3): rule G
  // needs issueType+riskId for idempotent risk-materialisation issues, rule F
  // reads phaseId. Bare Int refs like the other optional links.
  issueType        String    @default("Open Action") @map("issue_type") @db.VarChar(50)
  phaseId          Int?      @map("phase_id")
  riskId           Int?      @map("risk_id")
  context          String    @default("{}")
