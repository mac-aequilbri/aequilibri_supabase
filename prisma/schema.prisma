// COMMS (Spec 10 Core) — coordination layer. Was Airtable-only; this mirror
// gives recordWriter's `comms` entry a Postgres delegate target.
model PlatComms {
  id               Int       @id @default(autoincrement())
  airtableRecordId String? @map("airtable_record_id") @db.VarChar(20)
  orgId            Int       @map("org_id")
  jobId            Int?      @map("job_id")
  topic            String    @db.VarChar(300)
  messageType      String    @default("Status Update") @map("message_type") @db.VarChar(50)
  stakeholderRole  String    @default("Owner") @map("stakeholder_role") @db.VarChar(30)
  stakeholderId    Int?      @map("stakeholder_id")
  status           String    @default("pending") @db.VarChar(20)
  dueDate          DateTime? @map("due_date") @db.Date
  phaseId          Int?      @map("phase_id")
  linkedIssueId    Int?      @map("linked_issue_id")
  linkedDecisionId Int?      @map("linked_decision_id")
  sentBy           String    @default("") @map("sent_by") @db.VarChar(200)
  notes            String    @default("")
  createdAt        DateTime  @default(now()) @map("created_at")


  @@index([orgId, status])
  @@unique([orgId, airtableRecordId])

  @@map("plat_core_comms")
}

// PLAN (Spec 12 Core) — Module 5 task-level schedule. Was Airtable-only.
model PlatConPlanTask {
  id               Int       @id @default(autoincrement())
  airtableRecordId String? @map("airtable_record_id") @db.VarChar(20)
  orgId            Int       @map("org_id")
